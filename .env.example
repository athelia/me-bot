# Local Ollama models (see: ollama list)
OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
LLM_MODEL=qwen2.5:7b

# Set to true to print retrieved Discord messages before each reply
SHOW_SOURCES=false

# Retrieval: lower distance = better match (typical good matches: 0.65-0.85)
MAX_DISTANCE=0.88
TOP_K=3
FETCH_K=12
STATEMENT_K=3
MAX_REPLY_TOKENS=80

# Chat session log (appended after each exchange)
# CHAT_LOG_PATH=output/logs.txt
